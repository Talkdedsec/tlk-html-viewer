{
  "name": "tlk-html-viewer",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --experimental-strip-types --test tests/document.test.ts tests/i18n.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:production": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:standalone": "node --test tests/standalone.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.6",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "^1.0.0",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "type": "module",
  "description": "A customizable HTML, CSS and JavaScript studio with live preview",
  "license": "MIT",
  "overrides": {
    "fflate": "0.7.5"
  }
}
