{
  "name": "tlk-html-viewer",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-standalone.mjs",
    "test": "node --experimental-strip-types --test tests/document.test.ts tests/i18n.test.ts",
    "test:build": "node --test tests/standalone.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
